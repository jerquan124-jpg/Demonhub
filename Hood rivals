-- ── Hitbox ──
local function getTargetParts()
if hitboxTarget == "Head" then return {"HeadHitbox","Head"}
elseif hitboxTarget == "Torso" then return {"UpperTorso","LowerTorso"}
else return {"HeadHitbox","Head","UpperTorso","LowerTorso"} end
end
local function expandPlayer(player)
if player == LocalPlayer then return end
local char = getChar(player); if not char then return end
local root = char:FindFirstChild("HumanoidRootPart"); if not root then return end
for _, partName in ipairs(getTargetParts()) do
local part = char:FindFirstChild(partName); if not part then continue end
if not originalSizes[part] then originalSizes[part] = part.Size end
if not originalTransparencies[part] then originalTransparencies[part] = part.Transparency end
part.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
part.Transparency = hitboxTransparency
local weldKey = tostring(player.UserId)..partName
if not hitboxWelds[weldKey] then
local weld = Instance.new("WeldConstraint")
weld.Part0 = root; weld.Part1 = part; weld.Parent = root
hitboxWelds[weldKey] = weld
end
end
end
local function restorePlayer(player)
local char = getChar(player); if not char then return end
for _, partName in ipairs({"HeadHitbox","Head","UpperTorso","LowerTorso"}) do
local part = char:FindFirstChild(partName)
if part then
if originalSizes[part] then part.Size = originalSizes[part]; originalSizes[part] = nil end
if originalTransparencies[part] then part.Transparency = originalTransparencies[part]; originalTransparencies[part] = nil end
end
local weldKey = tostring(player.UserId)..partName
if hitboxWelds[weldKey] then hitboxWelds[weldKey]:Destroy(); hitboxWelds[weldKey] = nil end
end
end
local function expandAll() for _, p in ipairs(Players:GetPlayers()) do expandPlayer(p) end end
local function restoreAll() for _, p in ipairs(Players:GetPlayers()) do restorePlayer(p) end end
Players.PlayerAdded:Connect(function(p) p.CharacterAdded:Connect(function() task.wait(0.5); if hitboxEnabled then expandPlayer(p) end end) end)
for _, p in ipairs(Players:GetPlayers()) do p.CharacterAdded:Connect(function() task.wait(0.5); if hitboxEnabled then expandPlayer(p) end end) end
-- ── Gun Mods ──
local function getStats(tool) return tool:FindFirstChild("Stats") end
local function saveOriginals(tool, stats)
if originalValues[tool] then return end
originalValues[tool] = {}
for _, name in ipairs({"FireRate","Recoil","GunType","Shots","ReloadApe"}) do
local v = stats:FindFirstChild(name)
if v then originalValues[tool][name] = v.Value end
end
end
local function applyMods(tool)
local stats = getStats(tool); if not stats then return end
saveOriginals(tool, stats)
if rapidFireEnabled then
local fr = stats:FindFirstChild("FireRate"); if fr then fr.Value = RAPID_FIRE_RATE end
local gt = stats:FindFirstChild("GunType");  if gt then gt.Value = "Auto" end
local sh = stats:FindFirstChild("Shots");    if sh then sh.Value = 1 end
local ra = stats:FindFirstChild("ReloadApe"); if ra then ra.Value = 0 end
end
if noRecoilEnabled then
local r = stats:FindFirstChild("Recoil"); if r then r.Value = 0 end
end
end
local function restoreGunStats(names)
local containers = {LocalPlayer.Backpack}
if LocalPlayer.Character then table.insert(containers, LocalPlayer.Character) end
for _, container in ipairs(containers) do
for _, tool in ipairs(container:GetChildren()) do
if tool:IsA("Tool") then
local stats = getStats(tool); local saved = originalValues[tool]
if stats and saved then
for _, name in ipairs(names) do
local v = stats:FindFirstChild(name)
if v and saved[name] ~= nil then v.Value = saved[name] end
end
end
end
end
end
end
local function applyToAllGuns()
local containers = {LocalPlayer.Backpack}
if LocalPlayer.Character then table.insert(containers, LocalPlayer.Character) end
for _, container in ipairs(containers) do
for _, tool in ipairs(container:GetChildren()) do
if tool:IsA("Tool") then applyMods(tool) end
end
end
end
local function hookTool(tool)
task.wait(0.15)
local stats = getStats(tool); if not stats then return end
saveOriginals(tool, stats)
if rapidFireEnabled or noRecoilEnabled then applyMods(tool) end
end
LocalPlayer.Backpack.ChildAdded:Connect(function(c) if c:IsA("Tool") then hookTool(c) end end)
LocalPlayer.Backpack.ChildRemoved:Connect(function(c) originalValues[c] = nil end)
local function onCharAdded(char)
char.ChildAdded:Connect(function(c) if c:IsA("Tool") then hookTool(c) end end)
end
if LocalPlayer.Character then onCharAdded(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(onCharAdded)
-- ── Name Spoof (once only) ──
local function isRealName(text)
return text == REAL_NAME or text == REAL_DISPLAY_NAME
or text == "@"..REAL_NAME or text == "@"..REAL_DISPLAY_NAME
or string.lower(text) == string.lower(REAL_NAME)
or string.lower(text) == string.lower(REAL_DISPLAY_NAME)
end
local function scanAndReplace(root, fakeName)
for _, obj in ipairs(root:GetDescendants()) do
pcall(function()
if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
if isRealName(obj.Text) then obj.Text = fakeName end
end
if obj:IsA("Humanoid") then
if isRealName(obj.DisplayName) then obj.DisplayName = fakeName end
end
if obj:IsA("StringValue") then
if isRealName(obj.Value) then obj.Value = fakeName end
end
end)
end
end
local function fullNameSpoofScan(fakeName)
if LocalPlayer.Character then
local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
if hum then hum.DisplayName = fakeName end
scanAndReplace(LocalPlayer.Character, fakeName)
end
local pg = LocalPlayer:FindFirstChild("PlayerGui")
if pg then scanAndReplace(pg, fakeName) end
pcall(function() scanAndReplace(game:GetService("CoreGui"), fakeName) end)
pcall(function() scanAndReplace(workspace, fakeName) end)
end
local function resetNameSpoof()
fullNameSpoofScan(REAL_DISPLAY_NAME)
if LocalPlayer.Character then
local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
if hum then hum.DisplayName = REAL_DISPLAY_NAME end
end
end
LocalPlayer.CharacterAdded:Connect(function()
task.wait(1)
plantDemonTag()
if nameSpoofEnabled and currentSpoofName ~= "" then
fullNameSpoofScan(currentSpoofName)
end
end)
-- ── Ghost Cycler ──
local function ghostTeleport(target)
local myChar = LocalPlayer.Character; if not myChar then return end
local myRoot = myChar:FindFirstChild("HumanoidRootPart"); if not myRoot then return end
local targetChar = getChar(target); if not targetChar then return end
local targetRoot = targetChar:FindFirstChild("HumanoidRootPart"); if not targetRoot then return end
local hum = getHum(myChar)
if hum then
hum:ChangeState(Enum.HumanoidStateType.Physics)
hum.AutoRotate = false
end
myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, ghostOffset)
end
local function stopGhost()
local myChar = LocalPlayer.Character; if not myChar then return end
local hum = getHum(myChar)
if hum then hum:ChangeState(Enum.HumanoidStateType.GettingUp); hum.AutoRotate = true end
end
local function pickNextTarget()
local enemies = getEnemies()
if #enemies == 0 then currentTarget = nil return end
ghostIndex = ghostIndex + 1
if ghostIndex > #enemies then ghostIndex = 1 end
currentTarget = enemies[ghostIndex]
Rayfield:Notify({ Title = "👻 Ghost", Content = "Locked: "..currentTarget.Name, Duration = 2 })
end
local function watchTarget(target)
if not target then return end
local char = getChar(target); if not char then return end
local hum = getHum(char); if not hum then return end
hum.Died:Connect(function()
if ghostEnabled then task.wait(0.5); pickNextTarget(); if currentTarget then watchTarget(currentTarget) end end
end)
target.CharacterAdded:Connect(function()
if ghostEnabled then task.wait(1); currentTarget = target; watchTarget(currentTarget) end
end)
end
-- ── Main Loop ──
RunService.RenderStepped:Connect(function()
if hitboxEnabled then expandAll() end
if ghostEnabled then
if currentTarget == nil then
local enemies = getEnemies()
if #enemies > 0 then
ghostIndex = 1
currentTarget = enemies[1]
watchTarget(currentTarget)
Rayfield:Notify({ Title = "👻 Ghost", Content = "Locked: "..currentTarget.Name, Duration = 2 })
end
return
end
if not isPlayerAlive(currentTarget) then
pickNextTarget()
if currentTarget then watchTarget(currentTarget) end
return
end
ghostTeleport(currentTarget)
end
end)
LocalPlayer.CharacterAdded:Connect(function()
task.wait(0.5)
if ghostEnabled then currentTarget = nil; stopGhost() end
end)
