local function plantDemonTag()
local char = LocalPlayer.Character
if not char then return end
if char:FindFirstChild(DEMON_TAG_KEY) then return end
local tag = Instance.new("StringValue")
tag.Name  = DEMON_TAG_KEY
tag.Value = DEMON_TAG_VALUE
tag.Parent = char
end
