-- ── Team Detection ──
local function getMyTeam()
if LocalPlayer.Team then return LocalPlayer.Team end
for _, team in ipairs(Teams:GetTeams()) do
for _, p in ipairs(team:GetPlayers()) do
if p == LocalPlayer then return team end
end
end
return nil
end
local function isEnemy(player)
if player == LocalPlayer then return false end
local myTeam = getMyTeam()
if myTeam and player.Team then
return player.Team ~= myTeam
end
return player.TeamColor ~= LocalPlayer.TeamColor
end
local function isPlayerAlive(player)
local char = getChar(player)
if not char then return false end
local hum = getHum(char)
if not hum then return false end
return hum.Health > 0 and char:FindFirstChild("HumanoidRootPart") ~= nil
end
local function getEnemies()
local enemies = {}
for _, p in ipairs(Players:GetPlayers()) do
if isEnemy(p) and isPlayerAlive(p) then
table.insert(enemies, p)
end
end
return enemies
end
